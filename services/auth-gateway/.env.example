# Port the gateway listens on.
PORT=8080

# Where signed-in requests go: the internal address of the app to protect,
# e.g. http://<app-host>:3000. Left empty here on purpose: lly turns a host
# named in .env.example into an edge, and edges across sources fail to install.
UPSTREAM_URL=

# Comma-separated user:hash pairs. Make a hash with: npm run hash-password -- 'the password'
AUTH_USERS=admin:scrypt$16384$c2FsdA$aGFzaA

# At least 32 random characters. Changing it signs everyone out.
SESSION_SECRET=change-me-to-at-least-32-random-characters

# Hours a login stays valid.
SESSION_TTL_HOURS=12

# Set to false only for plain-http local testing.
COOKIE_SECURE=true
